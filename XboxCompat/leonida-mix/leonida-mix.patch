+DWORD WINAPI bp_installer(LPVOID) {
+    char buf[512];
+    buf[0] = 0;
+    GetEnvironmentVariableA("LEONIDA_BP", buf, sizeof(buf));
+    char probe_gate[4];
+    if (!buf[0] && !GetEnvironmentVariableA("LEONIDA_GATE", probe_gate, sizeof(probe_gate))) return 0;
+    std::vector<unsigned long long> wanted;
+    {   // LEONIDA_GATE=<wait addr>,<open addr>: hold every call of the first function until the second has been entered once.
+        char gate[64];
+        if (GetEnvironmentVariableA("LEONIDA_GATE", gate, sizeof(gate))) {
+            char* comma = std::strchr(gate, ',');
+            if (comma) {
+                *comma = 0;
+                g_gate_wait = std::strtoull(gate, nullptr, 16);
+                g_gate_open = std::strtoull(comma + 1, nullptr, 16);
+                g_gate_event = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+                wanted.push_back(g_gate_wait);
+                wanted.push_back(g_gate_open);
+            }
+        }
+    }
+    for (char* tok = std::strtok(buf, ","); tok && wanted.size() < 16; tok = std::strtok(nullptr, ","))
+        wanted.push_back(std::strtoull(tok, nullptr, 16));
+    for (int tries = 0; tries < 600 && g_bp_count < static_cast<int>(wanted.size()); ++tries) {
+        Sleep(100);
+        for (auto a : wanted) {
+            bool have = false;
+            for (int i = 0; i < g_bp_count; ++i) have |= g_bps[i].addr == a;
+            if (have) continue;
+            unsigned char b = 0;
+            SIZE_T got = 0;
+            if (!ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<void*>(a), &b, 1, &got) || got != 1 || b == 0 || b == 0xCC) continue;
+            DWORD old = 0;
+            if (!VirtualProtect(reinterpret_cast<void*>(a), 1, PAGE_EXECUTE_READWRITE, &old)) continue;
+            g_bps[g_bp_count] = {a, b};
+            *reinterpret_cast<unsigned char*>(a) = 0xCC;
+            ++g_bp_count;
+            std::fprintf(stderr, "[bp] armed %llx%s", a, "\n");
+        }
+    }
+    return 0;
+}
