+        // request at a window's base): that is what was asked for. Anything else is a real failure.
+        const DWORD err = GetLastError();
+        MEMORY_BASIC_INFORMATION mbi{};
+        const bool exact = VirtualQuery(address, &mbi, sizeof(mbi)) && mbi.BaseAddress == address &&
+                           mbi.RegionSize == size && mbi.State == MEM_RESERVE;
+        if (!exact) {
+            std::fprintf(stderr, "[rt] xmem: placeholder split at %p size 0x%zx failed, error %lu\n", address,
+                         static_cast<size_t>(size), err);
+            if (mbi.BaseAddress)
+                std::fprintf(stderr, "[rt] xmem:   region base %p allocation base %p size 0x%zx state 0x%lx type 0x%lx\n",
+                             mbi.BaseAddress, mbi.AllocationBase, static_cast<size_t>(mbi.RegionSize), mbi.State, mbi.Type);
+            return nullptr;
+        }
+    }
+    if (type & kMemPhysicalBit) {  // a physical reserve inside a placeholder stays a placeholder; page maps split it further
+        // Keep the larger extent when a carve starts at an existing window's base, or the parent would shrink and the
+        // next carve behind it would look "outside any window".
+        SIZE_T& extent = p.windows[reinterpret_cast<uintptr_t>(address)];
+        if (size > extent) extent = size;
+        return address;
+    }
+    return p.virtual_alloc2(GetCurrentProcess(), address, size, (type & (MEM_COMMIT | MEM_RESERVE)) | MEM_REPLACE_PLACEHOLDER,
+                            host_protect(protect), nullptr, 0);
+}
+
+void* WINAPI XMemVirtualAlloc(void* address, SIZE_T size, DWORD allocation_type, ULONGLONG attributes, DWORD protect) {
+    // Host-backed support covers ordinary and 64 KiB guest reservations. The 2 MiB guest mode needs an aligned
+    // reservation strategy that this shim does not provide, so fail explicitly instead of returning a misaligned
+    // region.
+    //
+    // The attribute word is recorded, not applied, as for XMemAlloc: the host has no allocator ids or memory types.
+    // The retail executable passes 0x21, 0x3, 0x183, 0x283 and 0x181 and stops at an int3 when a reservation
+    // returns NULL, so refusing a nonzero word is not an option.
+    note_attributes("XMemVirtualAlloc", attributes, size, _ReturnAddress());
+    if (size == 0) {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return nullptr;
+    }
+
+    if (allocation_type & (kMemReservePlaceholderBit | kMemReplacePlaceholderBit))
+        return placeholder_forms(address, size, allocation_type, protect);
+
+    const DWORD page_mode = allocation_type & kXmemPageModeMask;
+    if (page_mode == kXmemLargePages) {
+        // 2 MiB guest pages (XboxCompat): ordinary host pages, base and size rounded to 2 MiB. The host has no large-page
+        // privilege for a normal user and the guest only needs the address-space shape. Unmeasured: whether the title
+        // relies on the memory being physically contiguous.
+        constexpr SIZE_T kTwoMiB = 0x200000;
+        SIZE_T rounded = 0;
+        if (!round_up_size(size, kTwoMiB, rounded)) {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return nullptr;
+        }
+        DWORD type = allocation_type & kXmemHostAllocationTypeMask;
+        if (allocation_type & ~(kXmemHostAllocationTypeMask | kXmemLargePages)) {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return nullptr;
+        }
+        if (type == 0) type = MEM_RESERVE | MEM_COMMIT;
+        return alloc_aligned(address, rounded, kTwoMiB, type, host_protect(protect));
+    }
+    // 64 KiB mode with MEM_RESERVE only: an address window that XMemMapPhysicalPages fills later. Windows' own AWE needs
+    // SeLockMemoryPrivilege, so the window is an address-space placeholder (VirtualAlloc2) and pages are mapped into it.
+    if (page_mode == kXmem64kPages && (allocation_type & MEM_RESERVE) && !(allocation_type & MEM_COMMIT)) {
+        void* window = reserve_physical_window(address, size);
+        if (window) note_attributes("XMemVirtualAlloc(window)", attributes, size, _ReturnAddress());
+        return window;
+    }
+    if (page_mode != 0 && page_mode != kXmem64kPages) {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return nullptr;
+    }
+
+    const DWORD unsupported = allocation_type & ~(kXmemHostAllocationTypeMask | kXmemPageModeMask);
+    if (unsupported != 0) {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return nullptr;
+    }
+
+    DWORD host_type = allocation_type & kXmemHostAllocationTypeMask;
+    if (host_type == 0) host_type = MEM_RESERVE | MEM_COMMIT;
+
+    SYSTEM_INFO system_info{};
+    GetSystemInfo(&system_info);
+    const SIZE_T page_granularity = page_mode == kXmem64kPages ? kXmemPageSize64k : system_info.dwPageSize;
+    const SIZE_T base_granularity =
+        page_mode == kXmem64kPages
+            ? kXmemPageSize64k
+            : ((host_type & MEM_RESERVE) ? system_info.dwAllocationGranularity : system_info.dwPageSize);
+    if (page_granularity == 0 || (page_granularity & (page_granularity - 1)) != 0 || base_granularity == 0 ||
+        (base_granularity & (base_granularity - 1)) != 0) {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return nullptr;
+    }
+
+    if (address != nullptr) {
+        const uintptr_t requested = reinterpret_cast<uintptr_t>(address);
+        const uintptr_t max = (std::numeric_limits<uintptr_t>::max)();
+        if (size > max - requested) {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return nullptr;
+        }
+        const uintptr_t requested_end = requested + size;
+        const uintptr_t base = requested & ~(static_cast<uintptr_t>(base_granularity) - 1);
+        if (requested_end > max - (static_cast<uintptr_t>(page_granularity) - 1)) {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return nullptr;
+        }
+        const uintptr_t end = (requested_end + static_cast<uintptr_t>(page_granularity) - 1) &
+                              ~(static_cast<uintptr_t>(page_granularity) - 1);
+        address = reinterpret_cast<void*>(base);
+        size = static_cast<SIZE_T>(end - base);
+    } else if (page_mode == kXmem64kPages && !round_up_size(size, page_granularity, size)) {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return nullptr;
+    }
+
+    return VirtualAlloc(address, size, host_type, host_protect(protect));
+}
+
+// Physical-page family: inferred shapes (docs/xmem_exe_calls.md of the third-party project and our own trace):
+//   BOOL XMemAllocatePhysicalPages(ULONG64 flags, ULONG_PTR* count /*in/out, 64 KiB pages*/, ULONG_PTR* pages)
+//   BOOL XMemMapPhysicalPages(void* va, ULONG_PTR count, const ULONG_PTR* pages)   // pages == NULL unmaps
+//   BOOL XMemMapPhysicalPagesScatter(void** vas, ULONG_PTR count, const ULONG_PTR* pages)
+//   BOOL XMemFreePhysicalPages(ULONG_PTR count, ULONG_PTR* pages)                  // least certain
+BOOL WINAPI XMemAllocatePhysicalPages(ULONG64 /*flags*/, ULONG_PTR* count, ULONG_PTR* pages) {
+    if (!count || !pages) { SetLastError(ERROR_INVALID_PARAMETER); return FALSE; }
+    PhysPool& p = pool();
+    const std::lock_guard lock(p.mutex);
+    ULONG_PTR got = 0;
+    const ULONG_PTR want = *count;
+    for (ULONG_PTR i = 0; got < want; ++i) {
+        if (i >= p.used.size() && !ensure_chunk(p, i / kPhysChunkPages)) break;
+        if (!p.used[i]) { p.used[i] = true; pages[got++] = i; }
+    }
+    *count = got;
+    phys_log("[rt] xmem: XMemAllocatePhysicalPages(want %zu) -> got %zu\n", static_cast<size_t>(want), static_cast<size_t>(got));
+    return got != 0;
+}
+
+BOOL WINAPI XMemMapPhysicalPages(void* va, ULONG_PTR count, const ULONG_PTR* pages) {
+    PhysPool& p = pool();
+    const std::lock_guard lock(p.mutex);
+    if (!phys_apis(p)) { SetLastError(ERROR_NOT_SUPPORTED); return FALSE; }
+    for (ULONG_PTR i = 0; i < count; ++i) {
+        const uintptr_t a = reinterpret_cast<uintptr_t>(va) + i * kPhysPage;
+        if (!(pages ? map_page(p, a, pages[i]) : unmap_page(p, a))) {
+            phys_log("[rt] xmem: XMemMapPhysicalPages(va %p, %zu pages) FAILED at page %zu (va 0x%zx, error %lu)\n", va,
+                     static_cast<size_t>(count), static_cast<size_t>(i), static_cast<size_t>(a), GetLastError());
+            return FALSE;
+        }
+    }
+    phys_log("[rt] xmem: XMemMapPhysicalPages(va %p, %zu pages)%s ok\n", va, static_cast<size_t>(count), pages ? "" : " [unmap]");
+    return TRUE;
+}
+
+BOOL WINAPI XMemMapPhysicalPagesScatter(void** vas, ULONG_PTR count, const ULONG_PTR* pages) {
+    if (!vas) { SetLastError(ERROR_INVALID_PARAMETER); return FALSE; }
+    PhysPool& p = pool();
+    const std::lock_guard lock(p.mutex);
+    if (!phys_apis(p)) { SetLastError(ERROR_NOT_SUPPORTED); return FALSE; }
+    for (ULONG_PTR i = 0; i < count; ++i) {
+        const uintptr_t a = reinterpret_cast<uintptr_t>(vas[i]);
+        if (!(pages ? map_page(p, a, pages[i]) : unmap_page(p, a))) return FALSE;
+    }
+    return TRUE;
+}
+
+BOOL WINAPI XMemFreePhysicalPages(ULONG_PTR count, ULONG_PTR* pages) {
+    if (!pages) { SetLastError(ERROR_INVALID_PARAMETER); return FALSE; }
+    PhysPool& p = pool();
+    const std::lock_guard lock(p.mutex);
+    for (ULONG_PTR i = 0; i < count; ++i)
+        if (pages[i] < p.used.size()) p.used[pages[i]] = false;
+    return TRUE;
+}
+
+// The default (system) allocator behind the title's allocation hooks. MEASURED: the title's linear-allocator callback
+// (retail FUN_1456a2a60) asks the *next* callback in the chain, which ends in XMemAllocDefault, for its whole budget
+// and treats a null result as "not allocated yet", so a null here makes it restart its bump pointer on every request.
+// Page memory from VirtualAlloc is 64 KiB aligned, zeroed and not tied to the C heap.
+void* WINAPI XMemAllocDefault(size_t size, ULONGLONG attributes) {
+    void* p = VirtualAlloc(nullptr, size ? size : 1, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+    static std::atomic<int> logged{0};
+    if (logged.fetch_add(1, std::memory_order_relaxed) < 6)
+        std::fprintf(stderr, "[rt] xmem: XMemAllocDefault(0x%zx, attrs 0x%llx) -> %p\n", size, attributes, p);
+    return p;
+}
+
+void WINAPI XMemFreeDefault(void* p, ULONGLONG /*attributes*/) {
+    if (p) VirtualFree(p, 0, MEM_RELEASE);
+}
