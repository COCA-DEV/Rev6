+TitleAllocHook find_title_alloc_hook() {
+    static const TitleAllocHook hook = []() -> TitleAllocHook {
+        const auto* base = reinterpret_cast<const std::uint8_t*>(0x140000000ull);  // the retail image is mapped unrelocated
+        MEMORY_BASIC_INFORMATION mbi{};
+        if (!VirtualQuery(base, &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT || mbi.RegionSize < 0x1000) return nullptr;
+        if (base[0] != 'M' || base[1] != 'Z') return nullptr;
+        const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(base + reinterpret_cast<const IMAGE_DOS_HEADER*>(base)->e_lfanew);
+        if (nt->Signature != IMAGE_NT_SIGNATURE) return nullptr;
+        const IMAGE_DATA_DIRECTORY& dir = nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+        if (!dir.VirtualAddress) return nullptr;
+        const auto* exp = reinterpret_cast<const IMAGE_EXPORT_DIRECTORY*>(base + dir.VirtualAddress);
+        const auto* names = reinterpret_cast<const DWORD*>(base + exp->AddressOfNames);
+        const auto* ords = reinterpret_cast<const WORD*>(base + exp->AddressOfNameOrdinals);
+        const auto* funcs = reinterpret_cast<const DWORD*>(base + exp->AddressOfFunctions);
+        for (DWORD i = 0; i < exp->NumberOfNames; ++i) {
+            if (std::strcmp(reinterpret_cast<const char*>(base + names[i]), "__XMemAllocationHooks__") == 0) {
+                const auto* table = reinterpret_cast<void* const*>(base + funcs[ords[i]]);
+                return reinterpret_cast<TitleAllocHook>(table[0]);
+            }
+        }
+        return nullptr;
+    }();
+    return hook;
+}
+
+// True while the title has a callback registered for allocator id 0x80 on its list (retail 1.0.2.1: the list head is the
+// global at 0x146843770, nodes are {callback, data, thread, next}, and the chain always ends in a sentinel whose next is
+// null). Without a registration the hook would fall through to XMemAllocDefault and allocate real memory that nothing
+// frees, so the proxy only asks when there is something registered. MEASURED on this executable only.
+bool title_allocator_registered() {
+    const auto* image = reinterpret_cast<const std::uint8_t*>(0x140000000ull);
+    MEMORY_BASIC_INFORMATION mbi{};
+    if (!VirtualQuery(image + 0x6843770, &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT) return false;
+    const auto* head = *reinterpret_cast<const std::uint64_t* const*>(image + 0x6843770);
+    if (!head) return false;
+    if (!VirtualQuery(head, &mbi, sizeof(mbi)) || mbi.State != MEM_COMMIT) return false;
+    return head[3] != 0;
+}
