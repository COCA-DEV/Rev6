+// ---- XboxCompat: Zen 2 instructions that older CPUs lack -------------------------------------------------------------
+// The console CPU is Zen 2. The retail executable flushes written ranges with CLWB (66 0F AE /6), which Zen 1
+// (e.g. Ryzen 1000) and older Intel cores lack: it raises #UD (0xC000001D) in a cache-line loop. x86 memory is
+// cache-coherent for the CPU and the GPU's host-visible memory on a PC, so skipping the write-back is
+// behaviour-preserving here. RDPID (F3 0F C7 /7, register form) is Zen 2 as well: it returns the processor id. Both are
+// emulated here, once each logged; any other illegal instruction is left to the normal exception path.
+// ---- XboxCompat diagnostic: LEONIDA_BP=addr,addr,... (hex, title addresses) logs every call to those functions with rcx/rdx/r8/r9
+// and the caller, by planting an int3 and stepping over it. A poor man's debugger for "does the title ever call X".
+extern "C" long gta6rt_dstorage_total();
+extern "C" long gta6rt_dstorage_pending();
+static const unsigned long long g_start_tick = GetTickCount64();
+static HANDLE g_gate_event = nullptr;
+static unsigned long long g_gate_wait = 0, g_gate_open = 0;
+struct BpEntry { unsigned long long addr; unsigned char original; };
+static BpEntry g_bps[16];
+static int g_bp_count = 0;
+static thread_local int t_bp_rearm = -1;
+
+static void log_bp_hit(const BpEntry& bp, const CONTEXT& c) {
+    static std::atomic<int> total{0};
+    if (total.fetch_add(1) > 400) return;
+    unsigned long long ret = 0;
+    ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(c.Rsp), &ret, 8, nullptr);
+    std::fprintf(stderr, "[bp] %llx tid %lu rcx=%llx rdx=%llx r8=%llx r9=%llx ret=%llx%s", bp.addr, GetCurrentThreadId(),
+                 (unsigned long long)c.Rcx, (unsigned long long)c.Rdx, (unsigned long long)c.R8, (unsigned long long)c.R9,
+                 ret >= 0x140000000ull ? ret - 0x140000000ull : ret, "\n");
+}
