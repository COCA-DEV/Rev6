+// ---- XboxCompat diagnostic: LEONIDA_WATCH_LIB=1 logs the title's writes into its program array (library +0xc78) with a guard page.
+static unsigned long long g_watch_lo = 0, g_watch_hi = 0;
+static thread_local bool t_watch_rearm = false;
+DWORD WINAPI watch_installer(LPVOID) {
+    char buf[4];
+    if (!GetEnvironmentVariableA("LEONIDA_WATCH_LIB", buf, sizeof(buf)) || buf[0] != '1') return 0;
+    for (int tries = 0; tries < 3000; ++tries) {
+        Sleep(20);
+        unsigned long long lib = 0, arr = 0;
+        SIZE_T got = 0;
+        if (!ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(0x1476667b8ull), &lib, 8, &got) || !lib) continue;
+        if (!ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(lib + 0xc78), &arr, 8, &got) || !arr) continue;
+        g_watch_lo = arr;
+        g_watch_hi = arr + 0x1000;
+        DWORD old = 0;
+        VirtualProtect(reinterpret_cast<void*>(arr & ~0xfffull), 0x1000, PAGE_READWRITE | PAGE_GUARD, &old);
+        std::fprintf(stderr, "[watch] guarding program array %llx (library %llx)%s", arr, lib, "\n");
+        return 0;
+    }
+    return 0;
+}
