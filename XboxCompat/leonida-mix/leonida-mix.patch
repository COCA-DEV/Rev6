+// XMem allocation-type page bits select the guest page granularity and must not be forwarded as Win32 flags.
+constexpr DWORD kXmemLargePages = 0x20000000;
+constexpr DWORD kXmem64kPages = 0x20400000;
+constexpr DWORD kXmemPageModeMask = kXmem64kPages;
+constexpr SIZE_T kXmemPageSize64k = 0x10000;
+constexpr DWORD kXmemHostAllocationTypeMask =
+    MEM_COMMIT | MEM_RESERVE | MEM_RESET | MEM_TOP_DOWN | MEM_WRITE_WATCH | 0x01000000;
+
+bool round_up_size(SIZE_T value, SIZE_T alignment, SIZE_T& rounded) {
+    const SIZE_T max = (std::numeric_limits<SIZE_T>::max)();
+    if (alignment == 0 || (alignment & (alignment - 1)) != 0 || value > max - (alignment - 1)) return false;
+    rounded = (value + alignment - 1) & ~(alignment - 1);
+    return true;
+}
+
+// The console's PAGE_GRAPHICS_* protection bits (winnt.h: PAGE_GRAPHICS_NOACCESS 0x800 .. PAGE_GRAPHICS_NOCACHE
+// 0x40000). The host refuses them with ERROR_INVALID_PARAMETER, and the D3D12 layer reads guest memory through the
+// CPU mapping, so only the CPU protection is applied. The retail executable passes 0x801 and 0x22004.
+constexpr DWORD kPageGraphicsMask = 0x0007F800;
+
+DWORD host_protect(DWORD p) {
+    const DWORD cpu = p & ~kPageGraphicsMask;
+    return cpu ? cpu : PAGE_NOACCESS;
+}
+
+
+// ---- XboxCompat additions: aligned reservations and the "physical page" pool ------------------------------------------
+// Design (ours; semantics of flags/attributes unmeasured, see docs/research/re-addendum-ghidra.md and xmem_phys notes):
+//  * physical pages are 64 KiB slices of pagefile-backed sections (256 MiB chunks, created on demand);
+//  * a reserve-only 64 KiB-mode range becomes a placeholder; mapping replaces a 64 KiB piece with a view of a slice.
+void* alloc_aligned(void* address, SIZE_T size, SIZE_T align, DWORD type, DWORD protect) {
+    if (address) return VirtualAlloc(address, size, type, protect);
+    for (int attempt = 0; attempt < 16; ++attempt) {
+        void* probe = VirtualAlloc(nullptr, size + align, MEM_RESERVE, PAGE_NOACCESS);
+        if (!probe) return nullptr;
+        const uintptr_t a = (reinterpret_cast<uintptr_t>(probe) + align - 1) & ~(static_cast<uintptr_t>(align) - 1);
+        VirtualFree(probe, 0, MEM_RELEASE);
+        if (void* p = VirtualAlloc(reinterpret_cast<void*>(a), size, type, protect)) return p;
+    }
+    return nullptr;
+}
+
+constexpr ULONG_PTR kPhysPage = 64 * 1024;
+constexpr ULONG_PTR kPhysChunkPages = 4096;  // 256 MiB per section
+
+using PFN_VirtualAlloc2 = PVOID(WINAPI*)(HANDLE, PVOID, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER*, ULONG);
+using PFN_MapViewOfFile3 = PVOID(WINAPI*)(HANDLE, HANDLE, PVOID, ULONG64, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER*, ULONG);
+using PFN_UnmapViewOfFile2 = BOOL(WINAPI*)(HANDLE, PVOID, ULONG);
+
+struct PhysPool {
+    std::mutex mutex;
+    std::vector<HANDLE> chunks;
+    std::vector<bool> used;
+    std::map<uintptr_t, SIZE_T> windows;
+    std::unordered_set<uintptr_t> mapped;
+    PFN_VirtualAlloc2 virtual_alloc2 = nullptr;
+    PFN_MapViewOfFile3 map_view = nullptr;
+    PFN_UnmapViewOfFile2 unmap_view = nullptr;
+    bool loaded = false;
+};
+
+template <class... A>
+void phys_log(const char* fmt, A... args) {
+    static std::atomic<int> budget{40};
+    if (budget.fetch_sub(1, std::memory_order_relaxed) > 0) std::fprintf(stderr, fmt, args...);
+}
+
+PhysPool& pool() {
+    static auto* p = new PhysPool;  // process lifetime, never destroyed (worker threads may outlive statics)
+    return *p;
+}
+
+bool phys_apis(PhysPool& p) {
+    if (!p.loaded) {
+        p.loaded = true;
+        if (HMODULE k = GetModuleHandleW(L"kernelbase.dll")) {
+            p.virtual_alloc2 = reinterpret_cast<PFN_VirtualAlloc2>(GetProcAddress(k, "VirtualAlloc2"));
+            p.map_view = reinterpret_cast<PFN_MapViewOfFile3>(GetProcAddress(k, "MapViewOfFile3"));
+            p.unmap_view = reinterpret_cast<PFN_UnmapViewOfFile2>(GetProcAddress(k, "UnmapViewOfFile2"));
+        }
+    }
+    return p.virtual_alloc2 && p.map_view && p.unmap_view;
+}
+
+void* reserve_physical_window(void* address, SIZE_T size) {
+    PhysPool& p = pool();
+    const std::lock_guard lock(p.mutex);
+    if (!phys_apis(p)) { SetLastError(ERROR_NOT_SUPPORTED); return nullptr; }
+    void* w = p.virtual_alloc2(GetCurrentProcess(), address, size, MEM_RESERVE | MEM_RESERVE_PLACEHOLDER, PAGE_NOACCESS,
+                               nullptr, 0);
+    if (w) p.windows[reinterpret_cast<uintptr_t>(w)] = size;
+    return w;
+}
+
+bool in_window(PhysPool& p, uintptr_t a) {
+    auto it = p.windows.upper_bound(a);
+    while (it != p.windows.begin()) {
+        --it;
+        if (a >= it->first && a < it->first + it->second) return true;  // windows nest, so keep looking downwards
+    }
+    return false;
+}
+
+bool ensure_chunk(PhysPool& p, size_t chunk) {
+    while (p.chunks.size() <= chunk) {
+        const ULONG64 bytes = static_cast<ULONG64>(kPhysChunkPages) * kPhysPage;
+        HANDLE h = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, static_cast<DWORD>(bytes >> 32),
+                                      static_cast<DWORD>(bytes), nullptr);
+        if (!h) return false;
+        p.chunks.push_back(h);
+        p.used.resize(p.chunks.size() * kPhysChunkPages, false);
+    }
+    return true;
+}
+
+bool unmap_page(PhysPool& p, uintptr_t va) {
+    if (!p.mapped.count(va)) return true;
+    if (!p.unmap_view(GetCurrentProcess(), reinterpret_cast<PVOID>(va), MEM_PRESERVE_PLACEHOLDER)) return false;
+    p.mapped.erase(va);
+    return true;
+}
+
+bool map_page(PhysPool& p, uintptr_t va, ULONG_PTR index) {
+    if (va % kPhysPage || !in_window(p, va)) return false;
+    if (index >= p.used.size() || !p.used[index]) return false;
+    if (!unmap_page(p, va)) return false;
+    if (!VirtualFree(reinterpret_cast<PVOID>(va), kPhysPage, MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER)) {
+        // Fails (87 or 487) when the region already is exactly this 64 KiB placeholder, e.g. the last page of a range:
+        // nothing to split then.
+        MEMORY_BASIC_INFORMATION mbi{};
+        if (!(VirtualQuery(reinterpret_cast<PVOID>(va), &mbi, sizeof(mbi)) && mbi.BaseAddress == reinterpret_cast<PVOID>(va) &&
+              mbi.RegionSize == kPhysPage && mbi.State == MEM_RESERVE)) {
+            return false;
+        }
+    }
+    const ULONG64 offset = static_cast<ULONG64>(index % kPhysChunkPages) * kPhysPage;
+    if (!p.map_view(p.chunks[index / kPhysChunkPages], GetCurrentProcess(), reinterpret_cast<PVOID>(va), offset, kPhysPage,
+                    MEM_REPLACE_PLACEHOLDER, PAGE_READWRITE, nullptr, 0)) {
+        return false;
+    }
+    p.mapped.insert(va);
+    return true;
+}
+
+// Allocation-type bits the retail executable uses with placeholders (measured: 0x42000 reserve of ~185 MiB with
+// attribute 7, then five 0x20406000 requests at addresses inside it; docs/retail_boot_chain.md rows 10-11 report the
+// same). On Windows 0x40000 is MEM_RESERVE_PLACEHOLDER and 0x4000 is MEM_REPLACE_PLACEHOLDER, which plain VirtualAlloc
+// refuses; VirtualAlloc2 takes them.
+constexpr DWORD kMemReservePlaceholderBit = 0x00040000;
+constexpr DWORD kMemReplacePlaceholderBit = 0x00004000;
+constexpr DWORD kMemPhysicalBit = 0x00400000;
+
+void* placeholder_forms(void* address, SIZE_T size, DWORD type, DWORD protect) {
+    PhysPool& p = pool();
+    const std::lock_guard lock(p.mutex);
+    if (!phys_apis(p)) { SetLastError(ERROR_NOT_SUPPORTED); return nullptr; }
+    if (type & kMemReservePlaceholderBit) {
+        void* w = p.virtual_alloc2(GetCurrentProcess(), address, size, MEM_RESERVE | MEM_RESERVE_PLACEHOLDER, PAGE_NOACCESS,
+                                   nullptr, 0);
+        if (w) p.windows[reinterpret_cast<uintptr_t>(w)] = size;  // pages may be mapped into it, or sub-ranges carved out
+        std::fprintf(stderr, "[rt] xmem: placeholder reserve addr=%p size=0x%zx type=0x%lx -> %p (error %lu)\n", address,
+                     static_cast<size_t>(size), type, w, w ? 0 : GetLastError());
+        return w;
+    }
+    // MEM_REPLACE_PLACEHOLDER: carve exactly [address, address+size) out of a placeholder we reserved.
+    if (!address || !in_window(p, reinterpret_cast<uintptr_t>(address))) {
+        std::fprintf(stderr, "[rt] xmem: placeholder carve refused: address %p size 0x%zx type 0x%lx is not inside a reserved window\n",
+                     address, static_cast<size_t>(size), type);
+        SetLastError(ERROR_INVALID_ADDRESS);
+        return nullptr;
+    }
+    if (!VirtualFree(address, size, MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER)) {
