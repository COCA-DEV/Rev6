+// ---- XboxCompat diagnostic: LEONIDA_SAMPLE_THREADS=<seconds> prints where every thread of the process is, as
+// module+RVA (the game's or the host's), every few seconds. A poor man's profiler for "the title waits for something".
+DWORD WINAPI thread_sampler(LPVOID) {
+    char buf[16];
+    const DWORD interval = GetEnvironmentVariableA("LEONIDA_SAMPLE_THREADS", buf, sizeof(buf)) ? std::strtoul(buf, nullptr, 10) : 0;
+    if (!interval) return 0;
+    const DWORD self_thread = GetCurrentThreadId(), pid = GetCurrentProcessId();
+    for (int round = 0; round < 6; ++round) {
+        Sleep(interval * 1000);
+        HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        if (snap == INVALID_HANDLE_VALUE) continue;
+        THREADENTRY32 te{sizeof(te)};
+        std::fprintf(stderr, "[sample] ---- round %d%s", round, "\n");
+        for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+            if (te.th32OwnerProcessID != pid || te.th32ThreadID == self_thread) continue;
+            HANDLE th = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, te.th32ThreadID);
+            if (!th) continue;
+            if (SuspendThread(th) != (DWORD)-1) {
+                CONTEXT c{};
+                c.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+                if (GetThreadContext(th, &c)) {
+                    // Return addresses of the title's code found on the stack (a call opcode right before the address).
+                    std::string frames;
+                    int found = 0;
+                    const auto* sp = reinterpret_cast<const unsigned long long*>(c.Rsp);
+                    for (int i = 0; i < 1024 && found < 6; ++i) {
+                        unsigned long long v = 0;
+                        SIZE_T got = 0;
+                        if (!ReadProcessMemory(GetCurrentProcess(), sp + i, &v, sizeof(v), &got) || got != sizeof(v)) break;
+                        if (v < 0x140001000ull || v >= 0x14af40000ull) continue;
+                        unsigned char before[6] = {};
+                        if (!ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(v - 6), before, 6, &got)) continue;
+                        if (before[1] != 0xE8 && !(before[0] == 0xFF && before[1] == 0x15) && before[4] != 0xFF) continue;
+                        char one[32];
+                        std::snprintf(one, sizeof(one), " +0x%llx", v - 0x140000000ull);
+                        frames += one;
+                        ++found;
+                    }
+                    // Frames inside the host runtime (gta6rt.exe) - tells which shim a game thread is blocked in.
+                    if (found == 0 || interval > 0) {
+                        const auto host_base = reinterpret_cast<unsigned long long>(GetModuleHandleW(nullptr));
+                        const auto* nt = reinterpret_cast<const IMAGE_NT_HEADERS*>(host_base + reinterpret_cast<const IMAGE_DOS_HEADER*>(host_base)->e_lfanew);
+                        const unsigned long long host_end = host_base + nt->OptionalHeader.SizeOfImage;
+                        int hf = 0;
+                        for (int i = 0; i < 2048 && hf < 8; ++i) {
+                            unsigned long long v = 0;
+                            SIZE_T got = 0;
+                            if (!ReadProcessMemory(GetCurrentProcess(), sp + i, &v, sizeof(v), &got) || got != sizeof(v)) break;
+                            if (v < host_base || v >= host_end) continue;
+                            char one[32];
+                            std::snprintf(one, sizeof(one), " h+0x%llx", v - host_base);
+                            frames += one;
+                            ++hf;
+                        }
+                    }
+                    // Real unwind through the registered function tables (game .pdata + host + system).
+                    {
+                        CONTEXT uc = c;
+                        std::string chain;
+                        for (int depth = 0; depth < 24; ++depth) {
+                            DWORD64 image_base = 0;
+                            PRUNTIME_FUNCTION rf = RtlLookupFunctionEntry(uc.Rip, &image_base, nullptr);
+                            char one[48];
+                            if (image_base == 0x140000000ull) std::snprintf(one, sizeof(one), " G%llx", uc.Rip - image_base);
+                            else if (image_base) std::snprintf(one, sizeof(one), " %s", rt::startup_trace::where(uc.Rip).c_str());
+                            else std::snprintf(one, sizeof(one), " ?%llx", uc.Rip);
+                            chain += one;
+                            if (!rf) break;
+                            PVOID handler_data = nullptr;
+                            DWORD64 frame = 0;
+                            RtlVirtualUnwind(UNW_FLAG_NHANDLER, image_base, uc.Rip, rf, &uc, &handler_data, &frame, nullptr);
+                            if (!uc.Rip) break;
+                        }
+                        std::fprintf(stderr, "[sample] tid %lu chain:%s%s", te.th32ThreadID, chain.c_str(), "\n");
+                    }
+                    std::fprintf(stderr, "[sample] tid %lu rip=%s game-frames:%s%s", te.th32ThreadID,
+                                 rt::startup_trace::where(c.Rip).c_str(), frames.empty() ? " -" : frames.c_str(), "\n");
+                }
+                ResumeThread(th);
+            }
+            CloseHandle(th);
+        }
+        CloseHandle(snap);
+    }
+    return 0;
+}
